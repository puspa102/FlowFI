// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  fullName      String
  email         String   @unique
  password      String
  termsAccepted Boolean
  phone         String?
  country       String?
  currency      String   @default("USD")
  twoFactorEnabled Boolean @default(false)
  notificationEmail Boolean @default(true)
  notificationPush Boolean @default(true)
  notificationSms Boolean @default(false)
  createdAt     DateTime @default(now())
  accounts      Account[]
  transactions  Transaction[]
  insights      Insight[]
  healthReports WealthHealth[]
  budgetCategories BudgetCategory[]
  budgets         Budget[]
  goals           Goal[]
  budgetSuggestions BudgetSuggestion[]
  savingsStreaks    SavingsStreak[]
}

model Account {
  id           Int           @id @default(autoincrement())
  userId       Int
  name         String
  type         AccountType
  balance      Decimal       @db.Decimal(14, 2)
  currency     String        @default("USD")
  last4        String?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id                Int                 @id @default(autoincrement())
  userId            Int
  accountId         Int
  description       String
  merchant          String?
  category          String
  amount            Decimal             @db.Decimal(14, 2)
  type              TransactionType
  status            TransactionStatus
  occurredAt        DateTime
  isRecurring       Boolean             @default(false)
  recurringInterval String?
  createdAt         DateTime            @default(now())
  user              User                @relation(fields: [userId], references: [id])
  account           Account             @relation(fields: [accountId], references: [id])
}

model Insight {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  ctaLabel  String?
  ctaHref   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model WealthHealth {
  id        Int      @id @default(autoincrement())
  userId    Int
  score     Int
  label     String
  summary   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  CREDIT
}

enum TransactionCategory {
  FOOD_DINING
  RENT_UTILITIES
  SHOPPING
  INVESTMENTS
  AI_INSIGHTS
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  CLEARED
}

model PricingPlan {
  id          Int      @id @default(autoincrement())
  name        String
  priceLabel  String
  priceAmount Decimal? @db.Decimal(10, 2)
  priceSuffix String?
  summary     String
  ctaLabel    String
  ctaHref     String
  isPopular   Boolean  @default(false)
  features    String[]
  order       Int      @default(0)
}

model PricingFaq {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
  order    Int    @default(0)
}

model PartnerLogo {
  id    Int    @id @default(autoincrement())
  name  String
  order Int    @default(0)
}

model PricingCta {
  id             Int      @id @default(autoincrement())
  title          String
  subtitle       String
  primaryLabel   String
  primaryHref    String
  secondaryLabel String?
  secondaryHref  String?
}

model BudgetCategory {
  id     Int    @id @default(autoincrement())
  userId Int
  name   String
  icon   String?
  tone   String?
  order  Int    @default(0)
  user   User   @relation(fields: [userId], references: [id])
  budgets Budget[]
}

model Budget {
  id          Int          @id @default(autoincrement())
  userId      Int
  categoryId  Int
  month       DateTime
  limitAmount Decimal      @db.Decimal(14, 2)
  spentAmount Decimal      @db.Decimal(14, 2)
  status      BudgetStatus @default(ON_TRACK)
  user        User         @relation(fields: [userId], references: [id])
  category    BudgetCategory @relation(fields: [categoryId], references: [id])
}

model BudgetSuggestion {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  ctaLabel  String
  ctaHref   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model SavingsStreak {
  id        Int      @id @default(autoincrement())
  userId    Int
  months    Int
  progress  Int
  label     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Goal {
  id                 Int      @id @default(autoincrement())
  userId             Int
  title              String
  targetAmount       Decimal  @db.Decimal(14, 2)
  targetDate         DateTime
  currentAmount      Decimal  @db.Decimal(14, 2)
  monthlyContribution Decimal @db.Decimal(14, 2)
  progressPercent    Int
  statusLabel        String
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id])
}

enum BudgetStatus {
  ON_TRACK
  WARNING
  HEALTHY
}


