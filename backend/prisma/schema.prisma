// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  fullName      String
  email         String   @unique
  password      String
  termsAccepted Boolean
  phone         String?
  country       String?
  currency      String   @default("USD")
  twoFactorEnabled Boolean @default(false)
  notificationEmail Boolean @default(true)
  notificationPush Boolean @default(true)
  notificationSms Boolean @default(false)
  profileImage  String?
  createdAt     DateTime @default(now())
  accounts      Account[]
  transactions  Transaction[]
  insights      Insight[]
  healthReports WealthHealth[]
  budgetCategories BudgetCategory[]
  budgets         Budget[]
  goals           Goal[]
  budgetSuggestions BudgetSuggestion[]
  savingsStreaks    SavingsStreak[]
  investments   Investment[]
  subscriptions Subscription[]
  bankConnections BankConnection[]
  bankAccounts    BankAccount[]
  accountTransfers AccountTransfer[]
  anomalyAlerts AnomalyAlert[]
  expensePredictions ExpensePrediction[]
  familyMembers FamilyMember[]
}

model Account {
  id           Int           @id @default(autoincrement())
  userId       Int
  name         String
  type         AccountType
  balance      Decimal       @db.Decimal(14, 2)
  currency     String        @default("USD")
  last4        String?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id                Int                 @id @default(autoincrement())
  userId            Int
  accountId         Int
  description       String
  merchant          String?
  category          String
  amount            Decimal             @db.Decimal(14, 2)
  type              TransactionType
  status            TransactionStatus
  occurredAt        DateTime
  isRecurring       Boolean             @default(false)
  recurringInterval String?
  createdAt         DateTime            @default(now())
  user              User                @relation(fields: [userId], references: [id])
  account           Account             @relation(fields: [accountId], references: [id])
}

model Insight {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  ctaLabel  String?
  ctaHref   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model WealthHealth {
  id        Int      @id @default(autoincrement())
  userId    Int
  score     Int
  label     String
  summary   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  CREDIT
}

enum TransactionCategory {
  FOOD_DINING
  RENT_UTILITIES
  SHOPPING
  INVESTMENTS
  AI_INSIGHTS
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  CLEARED
}

model PricingPlan {
  id          Int      @id @default(autoincrement())
  name        String
  priceLabel  String
  priceAmount Decimal? @db.Decimal(10, 2)
  priceSuffix String?
  summary     String
  ctaLabel    String
  ctaHref     String
  isPopular   Boolean  @default(false)
  features    String[]
  order       Int      @default(0)
}

model PricingFaq {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
  order    Int    @default(0)
}

model PartnerLogo {
  id    Int    @id @default(autoincrement())
  name  String
  order Int    @default(0)
}

model PricingCta {
  id             Int      @id @default(autoincrement())
  title          String
  subtitle       String
  primaryLabel   String
  primaryHref    String
  secondaryLabel String?
  secondaryHref  String?
}

model BudgetCategory {
  id     Int    @id @default(autoincrement())
  userId Int
  name   String
  icon   String?
  tone   String?
  order  Int    @default(0)
  user   User   @relation(fields: [userId], references: [id])
  budgets Budget[]
}

model Budget {
  id          Int          @id @default(autoincrement())
  userId      Int
  categoryId  Int
  month       DateTime
  limitAmount Decimal      @db.Decimal(14, 2)
  spentAmount Decimal      @db.Decimal(14, 2)
  status      BudgetStatus @default(ON_TRACK)
  user        User         @relation(fields: [userId], references: [id])
  category    BudgetCategory @relation(fields: [categoryId], references: [id])
}

model BudgetSuggestion {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  ctaLabel  String
  ctaHref   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model SavingsStreak {
  id        Int      @id @default(autoincrement())
  userId    Int
  months    Int
  progress  Int
  label     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Goal {
  id                 Int      @id @default(autoincrement())
  userId             Int
  title              String
  targetAmount       Decimal  @db.Decimal(14, 2)
  targetDate         DateTime
  currentAmount      Decimal  @db.Decimal(14, 2)
  monthlyContribution Decimal @db.Decimal(14, 2)
  progressPercent    Int
  statusLabel        String
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id])
}

model Investment {
  id               Int           @id @default(autoincrement())
  userId           Int
  symbol           String
  name             String
  type             InvestmentType
  quantity         Decimal       @db.Decimal(20, 8)
  purchasePrice    Decimal       @db.Decimal(14, 2)
  currentPrice     Decimal       @db.Decimal(14, 2)
  allocation       Int
  lastUpdated      DateTime      @default(now())
  createdAt        DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id])
}

model Subscription {
  id               Int           @id @default(autoincrement())
  userId           Int
  name             String
  status           SubscriptionStatus
  monthlyPrice     Decimal       @db.Decimal(10, 2)
  billingDate      DateTime
  category         String
  lastActivity     DateTime?
  createdAt        DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id])
}

model BankConnection {
  id               Int           @id @default(autoincrement())
  userId           Int
  accountName      String
  accountType      String
  balance          Decimal       @db.Decimal(14, 2)
  maskedAccountNumber String
  lastSynced       DateTime
  syncStatus       SyncStatus
  createdAt        DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id])
}

model BankAccount {
  id            Int      @id @default(autoincrement())
  userId        Int
  name          String
  institution   String?
  type          BankAccountType
  balance       Decimal  @db.Decimal(14, 2) @default(0)
  currency      String   @default("NPR")
  color         String?
  icon          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
  transfers     AccountTransfer[]
}

model AnomalyAlert {
  id               Int           @id @default(autoincrement())
  userId           Int
  title            String
  description      String
  severity         String
  category         String
  detectedAmount   Decimal       @db.Decimal(14, 2)
  averageAmount    Decimal       @db.Decimal(14, 2)
  createdAt        DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id])
}

model ExpensePrediction {
  id               Int           @id @default(autoincrement())
  userId           Int
  month            DateTime
  predictedAmount  Decimal       @db.Decimal(14, 2)
  confidence       Int
  category         String
  createdAt        DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id])
}

model FamilyMember {
  id               Int           @id @default(autoincrement())
  userId           Int
  familyId         Int
  name             String
  email            String?
  role             String
  joinedAt         DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id])
  family           FamilyGroup   @relation(fields: [familyId], references: [id])
}

model FamilyGroup {
  id               Int           @id @default(autoincrement())
  name             String
  createdBy        Int
  createdAt        DateTime      @default(now())
  members          FamilyMember[]
  budgets          FamilyBudget[]
}

model FamilyBudget {
  id               Int           @id @default(autoincrement())
  familyId         Int
  category         String
  month            DateTime
  budgetAmount     Decimal       @db.Decimal(14, 2)
  spentAmount      Decimal       @db.Decimal(14, 2)
  percentUsed      Int
  createdAt        DateTime      @default(now())
  family           FamilyGroup   @relation(fields: [familyId], references: [id])
}

enum BudgetStatus {
  ON_TRACK
  WARNING
  HEALTHY
}

enum InvestmentType {
  STOCK
  ETF
  CRYPTO
  BOND
  MUTUAL_FUND
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  EXPIRED
}

enum SyncStatus {
  SYNCED
  SYNCING
  FAILED
}

enum BankAccountType {
  BANK
  DIGITAL_WALLET
  CASH
  CREDIT_CARD
  SAVINGS
  INVESTMENT
}

model AccountTransfer {
  id              Int      @id @default(autoincrement())
  userId          Int
  fromAccountId   Int
  toAccountId     Int
  amount          Decimal  @db.Decimal(14, 2)
  description     String?
  createdAt       DateTime @default(now())
  fromAccount     BankAccount @relation(fields: [fromAccountId], references: [id])
  user            User       @relation(fields: [userId], references: [id])
}


